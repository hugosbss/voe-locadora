APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (MySQL em produção)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cadastro_locadora
DB_USERNAME=cadastro
DB_PASSWORD=
# Em desenvolvimento/testes, caso seja necessário manter SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/database.sqlite

# Sessão
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Obrigatório true em produção (HTTPS):
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Força HTTPS fora de local/teste. Em produção, mantenha true.
FORCE_HTTPS=true
# Proxies confiáveis (CIDR ou IPs separados por vírgula).
# Preencha APENAS com a infraestrutura real de balanceador/CDN.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------- Segurança ----------

# Conta administrativa (gerada pelo comando `php artisan admin:provision`).
# ADMIN_NAME="Administrador"
# ADMIN_EMAIL=admin@locadora.com.br
# ADMIN_PASSWORD=DefinaUmaSenhaForteAqui

# Rate limiting
RATE_LIMIT_CADASTRO_PER_MINUTE=8
RATE_LIMIT_CADASTRO_DECAY_MINUTES=15
RATE_LIMIT_CEP_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MINUTES=30

# Versão da Política de Privacidade registrada no consentimento
PRIVACY_POLICY_VERSION=1.0

# Retenção de dados (dias), por status declarado do cadastro
RETENTION_NOVO_EM_ANALISE_DAYS=180
RETENTION_APROVADO_DAYS=1825
RETENTION_REPROVADO_DAYS=183

# Backups
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=storage/backups